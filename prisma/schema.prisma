// Ecomerg Arabic E-commerce + AI Behavior Engine - Full Schema (PostgreSQL/Neon)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id           String     @id @default(cuid())
  name         String
  nameEn       String?    // English translation (i18n)
  parentId     String?
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[] @relation("CategoryTree")
  slug         String     @unique
  isSub        Boolean    @default(false)
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  sku             String        @unique
  description     String        @default("")
  metaDescription String?
  // per-product SEO pack (AI/backfilled, admin-editable)
  metaTitle       String?
  keywords        String?
  // previous slug kept when slug is upgraded → 301 redirect old links
  legacySlug      String?
  price           Float
  salePrice       Float
  quantity        Int           @default(20)
  trackStock      Boolean       @default(false)
  disableOOS      Boolean       @default(false)
  thumb           String?
  images          String        @default("")
  categoryId      String?
  category        Category?     @relation(fields: [categoryId], references: [id])
  isBestSeller    Boolean       @default(false)
  // display social-proof counter (founder baseline + real orders)
  soldCount       Int           @default(0)
  // English translations (i18n) — null falls back to Arabic name
  nameEn          String?
  descriptionEn   String?
  // rank in "most demanded in Kuwait/Gulf" scoring (research-based);
  // 1..100 for homepage Top-100 section, null = not ranked
  demandRank      Int?
  variations      String?
  supplier        String?
  originalPrice   Float?
  // per-unit affiliate commission in KWD (نظام العمولات) — paid to the marketer per sold unit
  commission      Float         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  orderItems      OrderItem[]
  reviews         Review[]

  // AI relations (passive — referenced via onDelete)
  viewEvents      UserEvent[]
  triggerForUpsells UpsellOffer[]

  @@index([categoryId])
  @@index([isBestSeller])
  @@index([createdAt])
  @@index([demandRank])
}

// ===== Product Reviews & Ratings =====
// Global best practice: products with reviews convert up to 270% better
// (Kissmetrics); 92% of buyers hesitate when there are no reviews.
model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // order tie (optional): verified-buyer badge when the reviewer actually bought it
  orderId     String?
  customerName String
  rating      Int      // 1..5
  title       String?
  comment     String?
  // verified purchase (matched against real orders server-side)
  isVerified  Boolean  @default(false)
  // moderation: only approved reviews are public
  isApproved  Boolean  @default(false)
  // helpfulness voting (light-weight, IP-hash based)
  helpfulCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId, isApproved])
  @@index([isApproved, createdAt])
}

model Customer {
  id           String      @id @default(cuid())
  name         String
  phone        String
  email        String?
  city         String?
  area         String?
  address      String?
  /** bcrypt hash — default password equals the phone number until changed */
  passwordHash String?
  orders       Order[]
  sessions     UserSession[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([phone])
  @@index([email])
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  String      @unique
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  subtotal     Float
  shipping     Float       @default(0)
  total        Float
  status       String      @default("pending")
  paymentMethod String    @default("cod")
  notes        String?
  governorate  String?
  area         String?
  address      String?
  phone        String?
  customerName String?
  /** set daily at 10:00 Kuwait time by the auto-ship job */
  shippedAt    DateTime?
  deliveredAt  DateTime?
  /** human arrival promise shown to the customer */
  arrivalNote  String?

  // ===== Affiliate attribution (نظام العمولات) =====
  /// marketer who placed/owns this order — null for direct store orders
  affiliateId     String?
  affiliate       Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  /// affiliate code snapshot at order time
  affiliateCode   String?
  /// total commission owed for this order (snapshot, sum of items)
  commissionTotal Float?

  // Commission ledger entries tied to this order (earned/reversal)
  commissionEntries CommissionEntry[]
  /// withdrawal requests this order was included in
  withdrawalOrders  WithdrawalOrder[] @relation("WithdrawalOrders")

  // Ad-traffic attribution (utm params captured on first landing)
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  utmTerm      String?
  utmContent   String?
  /** landing page path the session started from */
  landingPath  String?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([utmSource])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  name        String
  sku         String
  price       Float
  quantity    Int
  image       String?
  variations  String?
  /// per-unit commission snapshot at order time (نظام العمولات)
  commission  Float     @default(0)

  @@index([orderId])
  @@index([productId])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  /// owner | admin | manager | support | viewer (legacy "staff" -> viewer)
  role         String    @default("viewer")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ===== Site Settings (Facebook Pixel / integrations) =====

model SiteSetting {
  key       String   @id // e.g. "facebook_pixel", "deepseek", "shipping"
  value     Json     // { enabled, pixelId, accessToken, testEventCode }
  updatedAt DateTime @updatedAt
}

// ===== Affiliate / Marketer Commission System (نظام العمولات والمحاسبة) =====

/// A marketer (مسوق) who sells products for a commission.
/// Affiliates register, browse products with commission info, place orders
/// for their customers, and withdraw their earned commission.
model Affiliate {
  id            String    @id @default(cuid())
  name          String
  /// Kuwaiti phone, used as login identifier
  phone         String    @unique
  email         String?   @unique
  passwordHash  String
  /// unique referral/shareable code (auto-generated)
  code          String    @unique
  /// active | suspended | pending (pending = awaiting admin approval)
  status        String    @default("active")
  /// payout preferences: knet | vodafone | paypal | bank
  paymentMethod  String?
  /// payout account identifier (IBAN / phone / email)
  paymentAccount String?
  notes         String?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders      Order[]
  ledger      CommissionEntry[]
  withdrawals WithdrawalRequest[]

  @@index([status])
}

/// Single source of truth for every commission money movement.
/// Types: earned (+, order delivered) | reversal (−, order returned/cancelled
/// after earning) | payout (−, money sent to affiliate) | adjustment (±, manual).
model CommissionEntry {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        String
  /// signed amount: positive increases balance, negative decreases
  amount      Float
  note        String?
  /// admin who performed a manual adjustment / payout
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
  @@index([orderId])
  @@index([type])
}

/// Withdrawal request: affiliate selects delivered orders whose commission
/// they want cashed out; admin approves & marks paid (with transfer proof).
model WithdrawalRequest {
  id            String    @id @default(cuid())
  affiliateId   String
  affiliate     Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  /// sum of selected orders' commission
  amount        Float
  /// knet | vodafone | paypal | bank
  method        String
  /// account snapshot at request time
  accountInfo   String?
  /// pending | paid | rejected
  status        String    @default("pending")
  adminNote     String?
  /// transfer proof (image URL) attached by admin on payment
  screenshotUrl String?
  /// transfer reference code entered by admin
  paymentRef    String?
  processedById String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders WithdrawalOrder[]

  @@index([affiliateId, status])
  @@index([status, createdAt])
}

/// Which delivered orders are included in a withdrawal request.
model WithdrawalOrder {
  id            String            @id @default(cuid())
  withdrawalId  String
  withdrawal    WithdrawalRequest @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order             @relation("WithdrawalOrders", fields: [orderId], references: [id], onDelete: Cascade)
  /// commission snapshot at selection time
  amount        Float

  @@unique([withdrawalId, orderId])
  @@index([orderId])
}

// ===== AI-Generated Landing Pages =====

model LandingPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  subtitle  String
  // AI-generated content: { sections: { features: [], testimonials: [], faq: [] }, cta: {...}, theme: {...} }
  content   Json
  // optional product ids to showcase
  productIds Json?
  heroImage  String?
  isActive   Boolean  @default(false)
  isFeatured Boolean  @default(false) // show link on storefront
  views      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([isFeatured])
}

// ===== AI Behavior Tracking & Upsell Engine =====

model UserSession {
  id           String     @id @default(cuid())
  // stable visitor id, stored in localStorage on client
  visitorId    String     @unique
  // optional: only if customer logs in
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id])
  // last-known geo (city-level, derived from IP at first call)
  ipHash       String?
  userAgent    String?
  referrer     String?
  // AI-derived traits
  persona      String?    // e.g. "bargain_hunter", "gadget_lover", "parent_shopper"
  intentScore  Float      @default(0.5) // 0..1 how close they are to buying
  budgetTier   String?    // low | mid | high | premium
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  events       UserEvent[]

  @@index([customerId])
}

enum EventType {
  page_view
  product_view
  search
  add_to_cart
  remove_from_cart
  cart_open
  checkout_start
  checkout_complete
  upsell_shown
  upsell_clicked
  upsell_added
  filter_apply
}

model UserEvent {
  id           String     @id @default(cuid())
  sessionId    String
  session      UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type         EventType
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  categoryId   String?
  query        String?
  // freeform metadata (price at click, qty, source widget, etc.)
  metadata     Json?
  createdAt    DateTime   @default(now())

  @@index([sessionId, createdAt])
  @@index([type])
  @@index([productId])
}

model UpsellOffer {
  id           String     @id @default(cuid())
  // composite key: per-session + trigger product gets one cached offer set
  sessionId    String
  triggerProductId String?
  trigger      Product?   @relation(fields: [triggerProductId], references: [id], onDelete: Cascade)
  // JSON array of recommendations: [{ productId, name, price, image, reason, score }]
  payload      Json
  // model version for cache invalidation
  modelVersion String     @default("v1")
  expiresAt    DateTime
  // was it clicked / added to cart? (for analytics)
  clicked      Boolean    @default(false)
  added        Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([sessionId, triggerProductId])
  @@index([expiresAt])
}
