# ==============================================
# Mahhl AI Commerce — Environment Template
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# cp .env.example .env
# ==============================================

# قاعدة البيانات — Neon PostgreSQL (pooler connection)
NEON_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# الاتصال المباشر (non-pooler) للـ migrations فقط
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# حساب الفاوندر / الأدمن (يُزرع تلقائياً عند أول تشغيل)
FOUNDER_EMAIL="founder@example.com"
FOUNDER_PASSWORD="change-me-please"

# Z-AI SDK — يُقرأ تلقائياً في بيئة workspace، ضعه هنا في النشر الخارجي
# ZAI_API_KEY=""

# ==============================================
# تتبع فيسبوك (اختياري — يمكن ضبطه من لوحة الإدارة بدلاً من هنا)
# ضع هنا قيماً افتراضية عند النشر، أو اتركها فارغة واضبط من لوحة التحكم
# ==============================================
# معرّف البكسل من Meta Events Manager → Data Sources
# FB_PIXEL_ID=""
# System User Access Token بصلاحية ads_management (لـ Conversions API)
# FB_ACCESS_TOKEN=""
# كود اختبار الأحداث من تبويب Test Events (اختياري)
# FB_TEST_EVENT_CODE=""
