# محل شوب — Environment Variables
# انسخ الملف لـ .env وعبّي القيم — لا ترفع .env إلى git أبداً

# ===== قاعدة البيانات (Neon PostgreSQL) =====
# Pooler URL (مع -pooler) — يستخدمه التطبيق وقت التشغيل
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Direct URL (بدون -pooler) — للـ migrations فقط
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ===== هوية الموقع =====
# الرابط العام (يستخدم للـ SEO/canonical وروابط المتاجر)
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ===== اختياري: DeepSeek AI لمساعد المسوقين =====
# يُدار من لوحة الأدمن (AI page) — يخزن في قاعدة البيانات، ما يحتاج متغير هنا

# ===== Vercel (تلقائي على المنصة) =====
# لا حاجة لأي إعداد إضافي — البناء بدون standalone

# ===== Garfix ERP Integration (المرحلة 1 + 2) =====
# عنوان مستقبِل webhooks في ERP (فواتير الطلبات + حالاتها)
ERP_WEBHOOK_URL="http://localhost:3000/api/webhooks/stores"
# سر التوقيع المشترك — نفس قيمة GARFIX_WEBHOOK_SECRET في ERP
# يستخدم لتوقيع webhooks الصادرة + للتحقق من طلبات تجهيز المتاجر الواردة من وكيل ERP
GARFIX_WEBHOOK_SECRET=""
